# Default CUDA 13 image recommended by upstream MinerU 3.2.1.
ARG MINERU_VLM_BASE_IMAGE=vllm/vllm-openai:v0.21.0
FROM ${MINERU_VLM_BASE_IMAGE}

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASHINFER_DISABLE_VERSION_CHECK=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app

RUN python3 -m pip install --break-system-packages --upgrade pip && \
    python3 -m pip install --break-system-packages -e '/app/third_party/MinerU[vlm,vllm]'

EXPOSE 30000

ENTRYPOINT ["mineru-openai-server"]
CMD ["--host", "0.0.0.0", "--port", "30000"]
